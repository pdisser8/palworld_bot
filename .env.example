# Discord bot token from the Developer Portal
DISCORD_TOKEN=

# Channel the server's console output gets streamed to
LOG_CHANNEL_ID=

# Channel where management commands (!status, !save, !restart) are accepted
CONTROL_CHANNEL_ID=

# Comma-separated list of Discord user IDs allowed to trigger server management commands
ALLOWED_USER_IDS=

# Command text that triggers a restart, matched case-insensitively
RESTART_COMMAND=!restart

# Seconds of warning given to players in-game before the server restarts
RESTART_DELAY_SECONDS=30

# Full path to PalServer.exe (or the .bat that launches it)
SERVER_EXE_PATH=C:\Program Files (x86)\Steam\steamapps\common\PalServer\PalServer.exe

# Args passed to the server exe. Keep -log so Unreal Engine emits console output!
SERVER_ARGS=-log

# Working directory to launch the server from (defaults to the exe's folder)
SERVER_CWD=

# Local file that receives a copy of the server console output
SERVER_LOG_PATH=palworld_server.log

# Palworld REST API configuration (must match AdminPassword in PalWorldSettings.ini)
PALWORLD_ADMIN_PASSWORD=
PALWORLD_REST_URL=http://127.0.0.1:8212

# Optional domain or custom IP to display for connections (e.g. pal.mydomain.com).
# If left blank, the bot automatically detects and displays your current public IP!
SERVER_DISPLAY_ADDRESS=
SERVER_PUBLIC_PORT=8211

# Optional command used to run the Palworld server updater.
# If unset, defaults to using C:\steamcmd\steamcmd.exe targeting the server directory.
# PALWORLD_UPDATER_CMD="C:\steamcmd\steamcmd.exe" +force_install_dir "C:\Program Files (x86)\Steam\steamapps\common\PalServer" +login anonymous +app_update 2394010 validate +quit

# Case-insensitive regex used to print possible player connection events
PLAYER_EVENT_PATTERN=login|logged in|joined|connected
